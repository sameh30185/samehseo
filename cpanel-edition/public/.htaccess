# SAMEH 12.0 — Apache rewrite (cPanel default)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L]
</IfModule>

# Deny access to sensitive patterns if misconfigured
<FilesMatch "\.(sql|md|env|json)$">
  Require all denied
</FilesMatch>
